# Copy this file to ".env" and fill in your values.  (.env is git-ignored)

# --- Secrets (leave blank if not needed) ---
HF_TOKEN=

# --- Paths / model ---
CHECKPOINT_PATH=isl_temporal_transformer_best.pt
LABELS_PATH=labels.json
CLIP_NAME=openai/clip-vit-base-patch32

# --- Runtime settings ---
CAMERA_INDEX=0
MAX_FRAMES=300
CHUNK_SIZE=10
IMAGE_SIZE=224
SAMPLE_INTERVAL=0.1
INFERENCE_INTERVAL=2.0
